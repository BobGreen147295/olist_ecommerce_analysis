# 本地开发：使用已安装的 Ollama
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 公开部署时建议配置访问密码和单会话调用上限
# MAX_AGENT_CALLS_PER_SESSION=20

# 账号体系：首次启动会用管理员配置自动创建管理员账号
# APP_ADMIN_USERNAME=revenueops_admin
# APP_ADMIN_PASSWORD=change-me
# APP_REGISTRATION_CODE=invite-only-code
# APP_ADMIN_RESET_PASSWORD=false  # 仅在忘记管理员密码时临时设为 true

# 云端任务持久化（PostgreSQL/Supabase）
# DATABASE_URL=postgresql://user:password@host:5432/database
# AGENT_LOG_PATH=data/processed/agent_runs.jsonl

# 云端部署：改为 openai，并在部署平台的 Secrets 中填写密钥
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace_me
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# 可选：将任务文件放到指定路径。云端建议替换为数据库存储。
# TASKS_PATH=data/processed/operation_tasks.json
# Optional local aggregate report bridge for the research station. Disabled when absent.
# Only PERSONAL_PLUS_LOCAL=1 on loopback; the owner must match APP_ADMIN_USERNAME.
# RESEARCH_REPORT_KEY=generate-a-separate-random-secret-at-least-32-characters
# RESEARCH_REPORT_OWNER=
# Account-scoped commerce reviews; server only. Use the research API origin, with HTTPS outside loopback.
# RESEARCH_SERVICE_URL=http://127.0.0.1:3001
# RESEARCH_SERVICE_KEY=independent-random-service-key-at-least-32-characters
# Optional public research website URL, compiled into the web navigation (never put a key here).
# NEXT_PUBLIC_RESEARCH_SITE_URL=

# 本地开发：使用已安装的 Ollama
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 云端部署：改为 openai，并在部署平台的 Secrets 中填写密钥
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace_me
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# 可选：将任务文件放到指定路径。云端建议替换为数据库存储。
# TASKS_PATH=data/processed/operation_tasks.json

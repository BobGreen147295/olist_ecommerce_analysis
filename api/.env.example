# Comma-separated trusted frontend origins. No trailing slash.
ALLOWED_ORIGINS=https://olist-revenueops.pages.dev,http://localhost:3000

# Choose one provider in the deployed API environment.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# Set these only in your deployment provider's secret settings, never in Git:
# OPENAI_API_KEY=...
# DATABASE_URL=postgresql://...

# Optional owner-only Google Apps Script notification, over HTTPS (not SMTP).
# Keep the real URL and secret in Render secrets or a git-ignored .env file.
# PILOT_NOTIFICATION_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# PILOT_NOTIFICATION_SECRET=at-least-32-random-characters
